# ==========================================================================
# Multi-LLM Provider Configuration
# Set keys for any providers you want. The app auto-detects the first
# configured provider, or you can explicitly set ACTIVE_PROVIDER.
# ==========================================================================

# Active provider: 'cerebras' | 'groq' | 'openai' | leave blank for auto-detect
ACTIVE_PROVIDER=cerebras

# --- Cerebras ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Groq (recommended for scheduling — full tool-calling support) ---
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# # OPENAI_MODEL=gpt-4o-mini
# # OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================================================
# Cal.com Scheduling Integration (optional)
# Fill these in to enable in-chat meeting scheduling with Google Meet.
# Setup: https://cal.com → Settings → Developer → API Keys
# ==========================================================================
CALCOM_API_KEY=cal_live_your_key_here
CALCOM_EVENT_TYPE_ID=123456
CALCOM_USERNAME=rahul-hirur
CALCOM_DEFAULT_TIMEZONE=Asia/Kolkata
CALCOM_AVAILABILITY_DAYS=7

# --- Hugging Face Deployment ---
# Token with write access to push backend directory
# HF_TOKEN=your_hugging_face_token_here

